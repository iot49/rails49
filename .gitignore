# OS
.DS_Store

# Secrets / generated config
.env
config.json

# Dependencies
node_modules
.venv
__pycache__

# Build artifacts
dist/

# Model files & build output — synced via GitHub Releases / deploy script,
# see classifier/resnet/README.md
classifier/resnet/models/*
!classifier/resnet/models/version.txt

# Detector weights and Ultralytics run output. Same rule as the classifier's:
# only version.txt is tracked. runs/ also holds the .pt checkpoints, which are
# what training produces and what export_onnx.py consumes.
detector/models/*
!detector/models/version.txt
detector/runs/
detector/*.log
# The DOTA-pretrained checkpoint Ultralytics downloads into the working
# directory on first use. Fetched, not authored.
detector/*.pt
rails49.org/ui/

# Detector benchmarking scratch — exported .ort variants and their timings
ui/bench/

# Data generated by dataset/ prep script (dataset/src/data_prep.ts)
dataset/data/

# YOLO OBB dataset derived by dataset/src/yolo_export.ts, and the corpus
# checkout it reads. Both are regenerated rather than versioned — the labels
# live in iot49/r49, and data.yaml carries an absolute path to this machine.
dataset/yolo/
dataset/r49/

# IDE files
*.code-workspace

# Claude Code — settings.json is shared and tracked; everything else is local
.claude/settings.local.json
.claude/worktrees/
.claude/.cc-writes/

# pnpm falls back to a store inside the repo when it cannot write the global
# one (a sandboxed install will do this). Never a source artifact.
.pnpm-store/

# Local dev scaffolding: a symlink to a corpus checkout for driving the
# diagnostics view without the file picker. Machine-specific.
#
# It must stay **out of `ui/public`**, which vite copies verbatim into `dist/`
# and `bin/deploy.sh` rsyncs to production — dereferencing the symlink on the
# way (#122). Ignoring it is not what keeps it out of the bundle; its location
# is. `ui/tests/publicDir.test.ts` is what holds that.
ui/proto-fixtures
